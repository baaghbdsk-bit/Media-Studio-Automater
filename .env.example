# Copy this file to .env and fill in the values you need.
# .env is git-ignored and will never be committed.

# --- Required for content generation (StudioEngine / AIGenerator / trend hunter) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Optional: social sessions (Base64-encoded Playwright storage_state JSON) ---
# Generate these with: python scripts/login_instagram.py / login_pinterest.py
# or export them from an existing browser session with tools/export_secrets.py
INSTAGRAM_COOKIES_BASE64=
PINTEREST_COOKIES_BASE64=
THREADS_COOKIES_BASE64=

# --- Optional: channel toggles (defaults shown) ---
# Fail the scheduled run / CI job when a configured channel fails to publish.
# Set to false if you prefer warnings only.
FAIL_ON_PUBLISH_ERROR=true
# Which channels are blocking. Comma-separated; others only emit CI annotations.
STRICT_PUBLISH_CHANNELS=instagram_reel
YOUTUBE_ENABLED=true
INSTAGRAM_ENABLED=true
PINTEREST_ENABLED=true
THREADS_ENABLED=true

# --- Optional: notifications ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: other integrations ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
DEVTO_API_KEY=
